{
  "name": "stock-app",
  "version": "1.0.0",
  "description": "Multi-branch stock management web app for electronics accessories",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "auth:secret": "node scripts/generate-better-auth-secret.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run --pool=threads",
    "test:watch": "vitest --pool=threads",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "nextjs",
    "stock-management",
    "inventory",
    "prisma",
    "postgresql"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "npm@11.11.1",
